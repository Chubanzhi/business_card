/* pages/index/index.wxss */
.container {
  padding: 0;
  padding-bottom: 120rpx;
}

/* --- 轮播图 --- */
.banner {
  width: 100%;
  height: 400rpx;
  border-radius: 0 0 32rpx 32rpx;
  overflow: hidden;
}

.banner-image {
  width: 100%;
  height: 100%;
}

.banner-placeholder {
  width: 100%;
  height: 400rpx;
  background: linear-gradient(135deg, var(--gradient-start), var(--gradient-end));
  border-radius: 0 0 32rpx 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.banner-placeholder-text {
  color: rgba(255, 255, 255, 0.8);
  font-size: 28rpx;
}

/* --- 店铺信息卡片 --- */
.shop-card {
  margin: 32rpx;
  margin-top: -20rpx;
  position: relative;
  z-index: 1;
}

.shop-header {
  display: flex;
  align-items: center;
  margin-bottom: 32rpx;
}

.shop-logo {
  width: 120rpx;
  height: 120rpx;
  border-radius: 24rpx;
  margin-right: 24rpx;
  box-shadow: var(--shadow-md);
  background: linear-gradient(135deg, var(--gradient-start), var(--gradient-end));
  display: flex;
  align-items: center;
  justify-content: center;
}

.shop-logo-text {
  font-size: 48rpx;
  color: #fff;
  font-weight: 600;
}

.shop-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.shop-name {
  font-size: 36rpx;
  font-weight: 600;
  color: var(--text-main);
  margin-bottom: 12rpx;
}

.shop-hours {
  font-size: 24rpx;
  color: var(--text-sub);
}

.shop-actions {
  display: flex;
  gap: 20rpx;
}

.action-btn {
  flex: 1;
  background-color: var(--primary-blue);
  color: #fff;
  border-radius: 50rpx;
  font-size: 26rpx;
  padding: 24rpx 0;
  font-weight: 500;
  box-shadow: var(--shadow-blue);
}

.action-btn:active {
  transform: scale(0.98);
}

/* --- 服务项目区域 --- */
.services-section {
  margin: 0 32rpx 32rpx;
}

.services-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 20rpx;
}

.service-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 24rpx 16rpx;
  background-color: var(--card-bg);
  border-radius: 24rpx;
  box-shadow: var(--shadow-sm);
  transition: transform 0.2s;
}

.service-item:active {
  transform: scale(0.95);
}

.service-icon {
  width: 80rpx;
  height: 80rpx;
  margin-bottom: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #dbeafe, #bfdbfe);
  border-radius: 20rpx;
}

.service-icon-text {
  font-size: 48rpx;
}

.service-name {
  font-size: 22rpx;
  color: var(--text-main);
  font-weight: 500;
  text-align: center;
}

/* --- 热门车型区域 --- */
.cars-section {
  margin: 0 32rpx 32rpx;
}

.cars-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 24rpx;
}

.car-item {
  background-color: var(--card-bg);
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: var(--shadow-md);
  transition: transform 0.2s;
}

.car-item:active {
  transform: scale(0.98);
}

.car-image {
  width: 100%;
  height: 300rpx;
  background: linear-gradient(135deg, #e0e7ff, #c7d2fe);
}

.car-info {
  padding: 24rpx;
}

.car-name {
  font-size: 28rpx;
  color: var(--text-main);
  font-weight: 600;
  margin-bottom: 12rpx;
  display: block;
}

.car-price {
  font-size: 26rpx;
  color: #ef4444;
  font-weight: 600;
  display: block;
}

/* --- 横向滚动车型 --- */
.cars-scroll {
  white-space: nowrap;
  padding-bottom: 10rpx;
}

.car-item-scroll {
  display: inline-block;
  width: 300rpx;
  margin-right: 24rpx;
  background-color: var(--card-bg);
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: var(--shadow-md);
  vertical-align: top;
}

.car-item-scroll .car-image {
  width: 100%;
  height: 200rpx;
}

.car-item-scroll .car-info {
  padding: 20rpx;
}

/* --- 优惠活动区域 --- */
.activities-section {
  margin: 0 32rpx 32rpx;
}

.activities-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.activity-item {
  display: flex;
  padding: 0;
  overflow: hidden;
  border-radius: 24rpx;
  box-shadow: var(--shadow-md);
  background-color: var(--card-bg);
}

.activity-image {
  width: 240rpx;
  height: 180rpx;
  flex-shrink: 0;
  background: linear-gradient(135deg, #fef3c7, #fde68a);
}

.activity-content {
  flex: 1;
  padding: 24rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.activity-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-main);
  margin-bottom: 12rpx;
  display: block;
}

.activity-desc {
  font-size: 24rpx;
  color: var(--text-sub);
  line-height: 1.5;
  display: block;
}
