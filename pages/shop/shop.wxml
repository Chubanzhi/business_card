<!--pages/shop/shop.wxml-->
<view class="container">
  <view class="shop-header card">
    <image class="shop-logo-large" src="/images/logo.png" mode="aspectFit" />
    <text class="shop-name-large">{{shopInfo.name}}</text>
  </view>

  <view class="info-section card">
    <view class="info-item">
      <text class="info-label">联系电话</text>
      <text class="info-value" bindtap="makePhoneCall">{{shopInfo.phone}}</text>
    </view>
    <view class="info-item">
      <text class="info-label">营业时间</text>
      <text class="info-value">{{shopInfo.businessHours}}</text>
    </view>
    <view class="info-item">
      <text class="info-label">店铺地址</text>
      <text class="info-value" bindtap="openLocation">{{shopInfo.address}}</text>
    </view>
    <view class="info-item">
      <text class="info-label">微信号</text>
      <text class="info-value" bindtap="copyWechat">{{shopInfo.wechat}}</text>
    </view>
  </view>

  <view class="actions-section">
    <button class="action-button primary" bindtap="makePhoneCall">📞 拨打电话</button>
    <button class="action-button" bindtap="openLocation">📍 导航到店</button>
    <button class="action-button" bindtap="copyWechat">💬 复制微信号</button>
  </view>
</view>

