/* pages/shop/shop.wxss */
.container {
  padding: 32rpx;
}

/* --- 店铺头部 --- */
.shop-header {
  text-align: center;
  padding: 60rpx 40rpx;
  margin-bottom: 32rpx;
}

.shop-logo-large {
  width: 200rpx;
  height: 200rpx;
  border-radius: 40rpx;
  margin-bottom: 32rpx;
  box-shadow: var(--shadow-lg);
  background: linear-gradient(135deg, var(--gradient-start), var(--gradient-end));
  display: flex;
  align-items: center;
  justify-content: center;
}

.shop-logo-large-text {
  font-size: 80rpx;
  color: #fff;
  font-weight: 600;
}

.shop-name-large {
  font-size: 40rpx;
  font-weight: 600;
  color: var(--text-main);
}

/* --- 信息列表 --- */
.info-section {
  margin-bottom: 32rpx;
}

.info-item {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  padding: 32rpx 0;
  border-bottom: 1rpx solid var(--border-color);
}

.info-item:last-child {
  border-bottom: none;
}

.info-label {
  font-size: 28rpx;
  color: var(--text-sub);
  font-weight: 500;
  flex-shrink: 0;
  width: 160rpx;
}

.info-value {
  font-size: 28rpx;
  color: var(--text-main);
  flex: 1;
  text-align: right;
  margin-left: 24rpx;
  word-break: break-all;
}

/* --- 操作按钮区域 --- */
.actions-section {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  margin-top: 48rpx;
}

.action-button {
  width: 100%;
  padding: 28rpx 0;
  border-radius: 50rpx;
  font-size: 30rpx;
  font-weight: 600;
  background-color: var(--card-bg);
  color: var(--text-main);
  border: 2rpx solid var(--border-color);
  box-shadow: var(--shadow-sm);
}

.action-button:active {
  transform: scale(0.98);
}

.action-button.primary {
  background-color: var(--primary-blue);
  color: #fff;
  border: none;
  box-shadow: var(--shadow-blue);
}
